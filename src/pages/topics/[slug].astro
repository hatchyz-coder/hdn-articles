---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { knowledgeTopics, matchesTopic } from '../../lib/topics';

export async function getStaticPaths() {
  return knowledgeTopics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .filter((article) => matchesTopic(article, topic))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articleHref = (id: string) => `${import.meta.env.BASE_URL}articles/${id}/`;
const canonical = new URL(`${import.meta.env.BASE_URL}topics/${topic.slug}/`, Astro.site);
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${topic.label} | HDN Articles`,
  description: topic.description,
  url: canonical.toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.data.title,
      url: new URL(articleHref(article.id), Astro.site).toString(),
    })),
  },
};
---
<BaseLayout
  title={`${topic.label}｜HDN Articles`}
  description={topic.description}
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <main>
    <section class="topic-page-hero">
      <div class="wrap topic-page-hero-inner">
        <div>
          <p class="eyebrow">HDN KNOWLEDGE TOPIC</p>
          <p class="topic-back"><a href={import.meta.env.BASE_URL}>← すべての記事・テーマへ</a></p>
          <h1>{topic.label}</h1>
          <p>{topic.description}</p>
        </div>
        <div class="topic-stat" aria-label={`${articles.length}件の記事`}>
          <strong>{String(articles.length).padStart(2, '0')}</strong>
          <span>公開記事</span>
        </div>
      </div>
    </section>

    <section class="wrap topic-page-list" aria-labelledby="topic-articles-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ARTICLES</p>
          <h2 id="topic-articles-title">このテーマの記事</h2>
        </div>
        <p class="section-note">新しい記事が公開されると自動でこの一覧に加わります。</p>
      </div>

      {articles.length > 0 ? (
        <div class="article-grid topic-article-grid">
          {articles.map((article, index) => (
            <article class="article-card">
              <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
              <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      ) : (
        <div class="topic-empty">
          <h3>このテーマの記事は準備中です。</h3>
          <p>公開記事が追加されると自動的にここへ表示されます。現在の記事はトップページから確認できます。</p>
          <a class="text-link" href={import.meta.env.BASE_URL}>記事トップへ <span aria-hidden="true">→</span></a>
        </div>
      )}
    </section>

    <section class="wrap home-cta topic-page-cta">
      <div>
        <p class="eyebrow">FROM KNOWLEDGE TO ACTION</p>
        <h2>自院の課題として整理したい方へ。</h2>
        <p>記事の一般論を、そのまま導入するのではなく、現在の患者導線や院内運用を確認して優先順位を整理します。</p>
      </div>
      <div class="cta-actions">
        <a class="button" href="https://hdnjapan.com/consultation.html">無料相談・患者導線診断</a>
        <a class="text-link" href="https://hdnjapan.com/">HDNについて <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
