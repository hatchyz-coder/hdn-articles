---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isClinicArticle, isLHubArticle } from '../../lib/audiences';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .filter(isLHubArticle)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articleHref = (id: string) => `${import.meta.env.BASE_URL}articles/${id}/`;
const medical = articles.filter(isClinicArticle);
const other = articles.filter((article) => !isClinicArticle(article));
const industryLabel = (industry?: string) => {
  const labels: Record<string, string> = {
    medical: '医療',
    dental: '歯科',
    'real-estate': '不動産',
    retail: '小売・EC',
    creator: 'クリエイター',
    fortune: '占い',
    other: 'その他',
  };
  return industry ? labels[industry] ?? industry : null;
};
---
<BaseLayout
  title="LHub活用・導入事例｜HDN Articles"
  description="LHubの予約、問診、決済、CRM、継続導線の活用記事を、医療機関とその他業種に分けて紹介します。"
>
  <main>
    <section class="lane-page-intro">
      <div class="wrap">
        <p class="eyebrow">LHUB USE CASES</p>
        <h1>LHubを、業種と目的から探す。</h1>
        <p>医療機関の患者導線と、その他業種の顧客導線を混ぜずに表示します。予約・問診・決済・CRM・継続フォローを、自社の運用に近い事例から確認できます。</p>
        <div class="lane-page-actions">
          <a class="text-link" href="#medical-lhub">医療・歯科での活用 ↓</a>
          <a class="text-link" href="#business-lhub">その他業種での活用 ↓</a>
          <a class="text-link" href="https://hdnjapan.com/lhub.html">LHub製品ページ →</a>
        </div>
      </div>
    </section>

    <section id="medical-lhub" class="wrap topic-page-list">
      <div class="section-heading">
        <div><p class="eyebrow">MEDICAL / DENTAL</p><h2>医療・歯科でのLHub活用</h2></div>
        <p class="section-note">患者導線、予約、問診、決済、再診・継続フォロー。</p>
      </div>
      {medical.length > 0 ? (
        <div class="article-grid topic-article-grid">
          {medical.map((article, index) => (
            <article class="article-card">
              <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <p class="article-meta"><span>{industryLabel(article.data.industry) ?? article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
              <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      ) : (
        <div class="topic-empty"><p>医療・歯科向け記事は準備中です。</p></div>
      )}
    </section>

    <section id="business-lhub" class="wrap topic-page-list">
      <div class="section-heading">
        <div><p class="eyebrow">OTHER INDUSTRIES</p><h2>その他業種でのLHub活用</h2></div>
        <p class="section-note">不動産、小売、クリエイター、コミュニティなど。</p>
      </div>
      {other.length > 0 ? (
        <div class="article-grid topic-article-grid">
          {other.map((article, index) => (
            <article class="article-card">
              <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <p class="article-meta"><span>{industryLabel(article.data.industry) ?? article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
              <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      ) : (
        <div class="topic-empty"><p>その他業種向け記事は準備中です。</p></div>
      )}
    </section>

    <section class="wrap lane-context" data-contextual-service-cta="lhub-lane">
      <div>
        <h2>LHubの導入を、自社の運用に合わせて確認する。</h2>
        <p>機能一覧だけでなく、LINE登録から予約・決済・継続利用まで、実際の業務フローに合わせて整理します。</p>
      </div>
      <div class="cta-actions">
        <a class="button" href="https://hdnjapan.com/lhub.html">LHubを見る</a>
        <a class="text-link" href="https://hdnjapan.com/consultation.html">導入を相談する →</a>
      </div>
    </section>
  </main>
</BaseLayout>
