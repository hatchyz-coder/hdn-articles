---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isClinicArticle, isLHubArticle } from '../../lib/audiences';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .filter(isClinicArticle)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articleHref = (id: string) => `${import.meta.env.BASE_URL}articles/${id}/`;
const categories = [
  ['自費診療・オンライン診療', ['自費', '自由診療', 'オンライン診療', 'AGA', 'ED', 'GLP-1']],
  ['患者導線・LINE', ['患者導線', 'LINE', '予約', '問診', '決済', '再診', 'CRM']],
  ['医療SNS・集患', ['SNS', 'YouTube', '動画', '集患', '医療マーケティング']],
  ['制度・コンプライアンス', ['医療広告', '薬機法', '景品表示法', '制度', '厚生労働省', 'PMDA']],
  ['クリニック経営・業務改善', ['経営', '業務改善', '院長', '事務長', 'AI', 'DX']],
] as const;
const text = (article: (typeof articles)[number]) => [article.data.title, article.data.description, article.data.category, ...article.data.tags].join(' ').toLowerCase();
const grouped = categories.map(([label, terms]) => ({
  label,
  items: articles.filter((article) => terms.some((term) => text(article).includes(term.toLowerCase()))).slice(0, 4),
}));
const clinicLhubCount = articles.filter(isLHubArticle).length;
const siteUrl = Astro.site ?? new URL('https://article.hdnjapan.com');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': new URL('/clinic/#collection', siteUrl).toString(),
      name: 'クリニックの自費診療・オンライン診療 実務知識',
      description: '自費診療の始め方、オンライン診療、LINE・予約・問診・決済、集患、医療広告を院長・事務長向けに整理するHDNの実務知識データベース。',
      url: new URL('/clinic/', siteUrl).toString(),
      isPartOf: { '@id': new URL('/#website', siteUrl).toString() },
      about: ['自費診療導入', 'オンライン診療', 'クリニック経営', '患者導線', 'LINE予約', '医療広告'],
      publisher: { '@type': 'Organization', name: '株式会社HDN', url: 'https://hdnjapan.com/' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'HDN Articles', item: new URL('/', siteUrl).toString() },
        { '@type': 'ListItem', position: 2, name: 'クリニック実務知識', item: new URL('/clinic/', siteUrl).toString() },
      ],
    },
  ],
};
---
<BaseLayout
  title="自費診療の始め方・オンライン診療の実務知識｜HDN Articles"
  description="保険診療中心の院長・事務長向けに、自費診療の始め方、価格・収益、オンライン診療、LINE・予約・問診・決済、医療広告を実務目線で整理します。"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <main>
    <section class="lane-page-intro">
      <div class="wrap">
        <p class="eyebrow">FOR CLINICS</p>
        <h1>自費診療を始めたい院長の、<br />実務知識データベース。</h1>
        <p>「何から始めるか」「在庫やスタッフ負担をどう抑えるか」「LINE・予約・問診・決済をどうつなぐか」。保険診療中心のクリニックが、自費診療を小さく始めて運用するための情報をまとめます。</p>
        <div class="lane-subnav">
          {categories.map(([label], index) => <a href={`#clinic-topic-${index + 1}`}>{label}</a>)}
        </div>
      </div>
    </section>

    <section class="wrap topic-page-list">
      <div class="section-heading">
        <div><p class="eyebrow">CLINIC KNOWLEDGE</p><h2>クリニック向け記事</h2></div>
        <p class="section-note">現在 {articles.length} 件。うちLHub関連 {clinicLhubCount} 件。一般論と個別判断を分け、一次情報へ辿れる記事を優先します。</p>
      </div>

      {grouped.map((group, groupIndex) => (
        <section id={`clinic-topic-${groupIndex + 1}`} class="lane-block">
          <div class="lane-heading"><h2>{group.label}</h2></div>
          {group.items.length > 0 ? (
            <div class="article-grid topic-article-grid">
              {group.items.map((article, index) => (
                <article class="article-card">
                  <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
                  <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
                  <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
                  <p>{article.data.description}</p>
                  <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
                </article>
              ))}
            </div>
          ) : (
            <div class="topic-empty"><p>このテーマの公開記事は準備中です。</p></div>
          )}
        </section>
      ))}
    </section>

    <section class="wrap lane-context" data-contextual-service-cta="clinic-lane">
      <div>
        <h2>何を導入するか決まっていなくても相談できます。</h2>
        <p>記事の一般論をそのまま当てはめず、診療科、患者層、院内体制、患者導線を確認し、自院で始められる選択肢と必要な仕組みを整理します。</p>
      </div>
      <div class="cta-actions">
        <a class="button" href="https://hdnjapan.com/consultation-form.html?cta_source=articles_clinic&cta_intent=self_pay&cta_position=bottom">自院で何を始められるか相談する</a>
      </div>
    </section>
  </main>
</BaseLayout>
