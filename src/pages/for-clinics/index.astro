---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = Astro.site ?? new URL('https://article.hdnjapan.com');
const pageUrl = new URL('/for-clinics/', siteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'HDN Articles',
      description: '医療機関向けの記事サイト制作・運用・保守システム。記事作成・編集・公開本数に制限なし。',
      provider: { '@type': 'Organization', name: '株式会社HDN', url: 'https://hdnjapan.com/' },
      areaServed: '日本',
      audience: { '@type': 'Audience', audienceType: '医療機関・クリニック' },
      url: pageUrl,
      offers: [
        { '@type': 'Offer', name: '初期導入費', price: '110000', priceCurrency: 'JPY', priceSpecification: { '@type': 'UnitPriceSpecification', price: '110000', priceCurrency: 'JPY', valueAddedTaxIncluded: true } },
        { '@type': 'Offer', name: '月額システム利用料', price: '55000', priceCurrency: 'JPY', priceSpecification: { '@type': 'UnitPriceSpecification', price: '55000', priceCurrency: 'JPY', valueAddedTaxIncluded: true, billingDuration: 'P1M' } },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'HDN Articles', item: new URL('/', siteUrl).toString() },
        { '@type': 'ListItem', position: 2, name: '医療機関向け記事サービス', item: pageUrl },
      ],
    },
  ],
};
---
<BaseLayout
  title="医療機関向け記事サイト制作・運用｜HDN Articles"
  description="記事本数ではなく月額システム利用料で、医療機関の記事サイト制作・運用・保守を支援。初期110,000円、月額55,000円（税込）、記事作成・編集・公開本数に制限なし。"
  canonical="/for-clinics/"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <main>
    <section class="lane-page-intro"><div class="wrap">
      <p class="eyebrow">FOR MEDICAL INSTITUTIONS</p>
      <h1>記事本数ではなく、<br />システム利用料として毎月定額で利用できます。</h1>
      <p><strong>初期導入費110,000円（税込）／月額システム利用料55,000円（税込）</strong></p>
      <p>記事作成・編集・公開本数に制限はありません。院長の音声やメモ、院内資料を基に、検索・AI検索から患者の疑問に応える記事サイトを制作・運用・保守します。</p>
      <div class="cta-actions"><a class="button" href="https://hdnjapan.com/consultation-form.html?cta_source=articles_service&cta_intent=content&cta_position=hero">記事サービス導入を相談する</a><a class="text-link" href="https://hdnjapan.com/article-service.html">料金と提供範囲を見る →</a></div>
    </div></section>

    <section class="wrap topic-page-list">
      <div class="section-heading"><div><p class="eyebrow">SCOPE</p><h2>サイト開設から制作・公開・保守まで</h2></div></div>
      <div class="article-grid topic-article-grid">
        <article class="article-card"><h3>初期導入</h3><p>サイト初期設定、サブドメイン支援、院情報・文体設定、アカウント発行、初期品質調整、公開テストを行います。</p></article>
        <article class="article-card"><h3>月額運用</h3><p>記事作成・編集・公開、英語版、SNS原稿、通常の保守・障害対応、バックアップを含みます。</p></article>
        <article class="article-card"><h3>品質維持</h3><p>制作順序、公開日程、内容確認等は運用状況に応じて調整します。個別確認、全面リライト、大量生成、独自連携は追加対応です。</p></article>
      </div>
    </section>

    <section class="wrap lane-context" data-contextual-service-cta="articles-service">
      <div><h2>運営・編集・医療情報の位置づけ</h2><p>運営会社は株式会社HDNです。一次情報を重視し、事実と考察を区別し、実務判断につながる編集を行います。本サイトの医療情報は一般的な情報提供であり、診断・治療や個別の医療上・法令上の判断を代替しません。</p><p>記事ごとの医療的妥当性や広告表現について最終判断が必要な場合は、医療機関または適切な専門家の確認を前提とします。</p></div>
      <div class="cta-actions"><a class="button" href="https://hdnjapan.com/consultation-form.html?cta_source=articles_service&cta_intent=content&cta_position=bottom">導入について問い合わせる</a><a class="text-link" href="https://hdnjapan.com/disclaimer.html">免責事項 →</a></div>
    </section>
  </main>
</BaseLayout>
