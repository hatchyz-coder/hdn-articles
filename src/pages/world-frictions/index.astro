---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isWorldFrictionsArticle } from '../../lib/audiences';
import { activeLinkedInChannel, activeLinkedInDestination, distributionChannels } from '../../lib/distribution';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .filter(isWorldFrictionsArticle)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articleHref = (id: string) => `${import.meta.env.BASE_URL}articles/${id}/`;
---
<BaseLayout
  title="世界の違和感｜HDN Articles"
  description="みんなが何となく「あれ？」と感じる社会のズレを、一次資料・研究・報道まで掘って言語化するHDNの連載です。"
>
  <main>
    <section class="lane-page-intro">
      <div class="wrap">
        <p class="eyebrow">WORLD FRICTIONS</p>
        <h1>世界の違和感</h1>
        <p>みんなが何となく「あれ？」と感じる社会のズレを、具体例、一次資料、研究、信頼できる報道まで追い、構造として言語化します。AI、働き方、広告、医療、都市、文化。テーマは違っても、問いは同じです。</p>
        <div class="series-note">違和感 → 具体例 → なぜそう感じるか → 構造 → 一次資料 → 考察 → 読者への問い。単なるニュース要約や炎上集ではなく、「なぜそうなっているのか」まで掘ります。</div>
      </div>
    </section>

    <section class="wrap topic-page-list">
      <div class="section-heading">
        <div><p class="eyebrow">ARTICLES</p><h2>この連載の記事</h2></div>
        <p class="section-note">一次資料へ辿れること、事実と考察を分けることを基本にしています。</p>
      </div>
      {articles.length > 0 ? (
        <div class="article-grid topic-article-grid">
          {articles.map((article, index) => (
            <article class="article-card">
              <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
              <h3><a data-world-frictions-related href={articleHref(article.id)}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="read-more" data-world-frictions-related href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      ) : (
        <div class="topic-empty">
          <h3>現在、公開中の記事はありません。</h3>
          <p>新しい記事を公開次第、このページに追加します。</p>
        </div>
      )}
    </section>

    <section class="wrap distribution-panel" aria-labelledby="distribution-heading">
      <div class="distribution-panel-head">
        <div>
          <p class="eyebrow">FOLLOW</p>
          <h2 id="distribution-heading">読みやすい場所で、続きを追えます。</h2>
        </div>
        <p>HDN Articlesでは一次資料や参考文献まで含めた記事を公開しています。LinkedInでは、経営や仕事に関わるテーマを中心に紹介しています。</p>
      </div>
      <div class="distribution-grid">
        <div class="distribution-card">
          <small>HDN ARTICLES</small>
          <h3>このサイトで読む</h3>
          <p>一次資料、参考文献、関連記事まで含めて、テーマを深く読みたい方はこちらから。</p>
          <a href={distributionChannels.canonicalBase}>HDN Articlesトップを見る →</a>
        </div>
        <div class="distribution-card">
          <small>LINKEDIN</small>
          <h3>LinkedInで読む</h3>
          <p>経営、働き方、AI、医療など、専門職や経営者にも関わるテーマを紹介しています。</p>
          <a href={activeLinkedInDestination} data-distribution-channel={activeLinkedInChannel} rel="me">LinkedInでフォロー →</a>
        </div>
        {distributionChannels.note && (
          <div class="distribution-card">
            <small>NOTE</small>
            <h3>noteで読む</h3>
            <p>社会や日常の違和感を、より読みやすい形で届けています。</p>
            <a href={distributionChannels.note} data-distribution-channel="note">noteで読む →</a>
          </div>
        )}
      </div>
    </section>

    <section class="wrap lane-context">
      <div>
        <h2>気になったテーマから、次の「違和感」へ。</h2>
        <p>記事一覧では、テーマやキーワードから関連する記事を探せます。</p>
      </div>
      <div class="cta-actions">
        <a class="button" href={`${import.meta.env.BASE_URL}articles/?section=world-frictions`}>記事を探す</a>
        <a class="text-link" href="https://hdnjapan.com/">HDNについて →</a>
      </div>
    </section>
  </main>
</BaseLayout>
