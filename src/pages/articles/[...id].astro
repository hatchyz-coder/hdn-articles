---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const englishArticles = await getCollection('articlesEn', ({ data }) => !data.draft);
  const englishIds = new Set(englishArticles.map((item) => item.id));
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article, articles, hasEnglish: englishIds.has(article.id) },
  }));
}

const { article, articles, hasEnglish } = Astro.props;
const { Content } = await render(article);
const articleUrl = new URL(`${import.meta.env.BASE_URL}articles/${article.id}/`, Astro.site);
const englishUrl = hasEnglish ? new URL(`${import.meta.env.BASE_URL}en/articles/${article.id}/`, Astro.site) : undefined;
const ogImage = new URL(`${import.meta.env.BASE_URL}og/ja/${article.id}.png`, Astro.site);
const tagSet = new Set(article.data.tags);
const relatedArticles = articles
  .filter((candidate) => candidate.id !== article.id)
  .map((candidate) => ({
    article: candidate,
    score:
      (candidate.data.category === article.data.category ? 4 : 0) +
      candidate.data.tags.filter((tag) => tagSet.has(tag)).length * 2,
  }))
  .sort((a, b) => b.score - a.score || b.article.data.publishedAt.valueOf() - a.article.data.publishedAt.valueOf())
  .slice(0, 3)
  .map(({ article }) => article);

const author = {
  '@type': 'Person',
  name: article.data.author,
  jobTitle: '株式会社HDN 代表 / クリニック経営・AI活用',
  worksFor: { '@type': 'Organization', name: '株式会社HDN', url: 'https://hdnjapan.com/' },
  knowsAbout: ['クリニック経営', '自由診療', '医療DX', 'LINE活用', 'AI活用'],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: article.data.title,
      description: article.data.description,
      datePublished: article.data.publishedAt.toISOString(),
      dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
      articleSection: article.data.category,
      keywords: article.data.tags.join(', '),
      inLanguage: 'ja',
      image: ogImage.toString(),
      author,
      publisher: { '@type': 'Organization', name: '株式会社HDN', url: 'https://hdnjapan.com/' },
      mainEntityOfPage: articleUrl.toString(),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'HDN Articles', item: new URL(import.meta.env.BASE_URL, Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: article.data.category },
        { '@type': 'ListItem', position: 3, name: article.data.title, item: articleUrl.toString() },
      ],
    },
  ],
};

const looksLikeSnsArticle =
  article.data.tags.some((tag) => ['医療SNS', 'YouTube', 'SNS', '動画'].includes(tag)) ||
  /SNS|YouTube|動画/.test(article.data.category) ||
  /SNS|YouTube|動画/.test(article.data.title);
const resolvedCtaKey = article.data.cta === 'consultation' && looksLikeSnsArticle ? 'sns' : article.data.cta;
const ctaConfig = {
  consultation: {
    title: '自院の患者導線を一度、整理してみる',
    copy: 'LINE、予約、問診、決済、診療後フォローまで、現在どこで患者が止まっているかを確認します。',
    label: '無料相談・患者導線診断を見る',
    href: 'https://hdnjapan.com/consultation.html',
  },
  lhub: {
    title: 'LINEの先まで、患者導線をつなげる',
    copy: '予約・問診・決済・患者管理・フォローを分断せずに設計したい場合は、LHubの考え方と支援範囲をご覧ください。',
    label: 'LHubを見る',
    href: 'https://hdnjapan.com/lhub.html',
  },
  'self-pay': {
    title: '自費診療を「メニュー追加」で終わらせない',
    copy: '診療設計、患者導線、院内運用、継続フォローまで含めた自費診療導入支援の考え方をまとめています。',
    label: '自費診療導入支援を見る',
    href: 'https://hdnjapan.com/self-pay.html',
  },
  sns: {
    title: 'SNS・動画を、予約までつながる導線にする',
    copy: '再生数や投稿本数だけではなく、患者の不安解消からLINE・予約・受診までを一つの導線として設計します。',
    label: '医療SNS・動画戦略を見る',
    href: 'https://hdnjapan.com/medical-sns.html',
  },
}[resolvedCtaKey];
---
<BaseLayout
  title={`${article.data.title} | HDN Articles`}
  socialTitle={article.data.socialTitle}
  description={article.data.description}
  canonical={articleUrl}
  type="article"
  image={ogImage}
  alternateJa={articleUrl}
  alternateEn={englishUrl}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="wrap article">
    <nav class="breadcrumbs" aria-label="パンくずリスト">
      <a href={import.meta.env.BASE_URL}>HDN Articles</a><span>›</span><span>{article.data.category}</span>
    </nav>
    <header class="article-header">
      <p class="meta">{article.data.category}｜{article.data.publishedAt.toLocaleDateString('ja-JP')}｜{article.data.author}</p>
      <h1>{article.data.title}</h1>
      <p class="article-description">{article.data.description}</p>
      {article.data.updatedAt && <p class="article-updated">最終更新：{article.data.updatedAt.toLocaleDateString('ja-JP')}</p>}
      {englishUrl && <p class="language-switch"><a href={englishUrl.pathname}>Read this article in English →</a></p>}
    </header>
    <Content />

    <aside class="author-box" aria-labelledby="author-heading">
      <div class="author-mark" aria-hidden="true">TH</div>
      <div>
        <p class="eyebrow">AUTHOR</p>
        <h2 id="author-heading">羽田野 剛士</h2>
        <p class="author-role">株式会社HDN 代表｜クリニック経営・AI活用</p>
        <p>クリニックの自由診療導入、業務改善、LINEを活用した予約・問診・決済導線、AI活用などを実務面から支援。制度やニュースの紹介だけでなく、「現場ではどう運用するか」まで落とし込んだ情報発信を行っています。</p>
        <a class="text-link" href="https://hdnjapan.com/tsuyoshi-hadano.html">代表者・支援領域を見る <span>→</span></a>
      </div>
    </aside>

    {relatedArticles.length > 0 && (
      <section class="related-section" aria-labelledby="related-heading">
        <p class="eyebrow">RELATED INSIGHTS</p>
        <h2 id="related-heading">あわせて読みたい記事</h2>
        <div class="related-grid">
          {relatedArticles.map((item) => (
            <article class="related-card">
              <p class="article-meta"><span>{item.data.category}</span>{item.data.publishedAt.toLocaleDateString('ja-JP')}</p>
              <h3><a href={`${import.meta.env.BASE_URL}articles/${item.id}/`}>{item.data.title}</a></h3>
              <p>{item.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <aside class="cta" data-contextual-service-cta={resolvedCtaKey}>
      <h2>{ctaConfig.title}</h2>
      <p>{ctaConfig.copy}</p>
      <a class="button" href={ctaConfig.href}>{ctaConfig.label}</a>
      {resolvedCtaKey !== 'consultation' && (
        <p><a class="text-link" href="https://hdnjapan.com/consultation.html">まず患者導線を整理したい場合はこちら <span>→</span></a></p>
      )}
    </aside>
  </main>
</BaseLayout>
