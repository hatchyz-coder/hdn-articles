---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/market-radar.css';

export async function getStaticPaths() {
  const reports = await getCollection('radarReports', ({ data }) =>
    data.product === 'market-radar' && !data.draft
  );

  return reports.map((report) => ({
    params: { slug: report.id.split('/').at(-1) },
    props: { report },
  }));
}

type Props = {
  report: CollectionEntry<'radarReports'>;
};

const { report } = Astro.props as Props;
const { Content } = await render(report);
const canonical = report.data.canonical ?? `${import.meta.env.BASE_URL}market-radar/reports/${report.id.split('/').at(-1)}/`;
---

<BaseLayout
  title={`${report.data.title} | MarketRadar`}
  description={report.data.description}
  canonical={canonical}
  type="article"
>
  <main class="wrap radar-report">
    <nav class="radar-breadcrumb" aria-label="パンくず">
      <a href={`${import.meta.env.BASE_URL}market-radar/`}>MarketRadar</a>
      <span aria-hidden="true">/</span>
      <span>Report</span>
    </nav>
    <header class="report-header">
      <p class="radar-kicker">MarketRadar Report</p>
      <h1>{report.data.title}</h1>
      <p class="lead">{report.data.description}</p>
      <dl class="report-meta-grid">
        <div><dt>公開日</dt><dd>{report.data.publishedAt.toLocaleDateString('ja-JP')}</dd></div>
        <div><dt>カテゴリ</dt><dd>{report.data.category}</dd></div>
        <div><dt>データ基準日</dt><dd>{report.data.dataAsOf?.toLocaleDateString('ja-JP') ?? '確認中'}</dd></div>
        <div><dt>レビュー</dt><dd>{report.data.legalReview === 'completed' ? '確認済み' : '確認中'}</dd></div>
      </dl>
    </header>

    <article class="report-body" aria-label="レポート本文">
      <Content />
    </article>

    <aside class="radar-cta">
      <p class="radar-section-number">相談</p>
      <div>
        <h2>自社の商品・サービスで、同じ分析を行う</h2>
        <p>市場データの確認から、比較軸、記事、営業資料への落とし込みまで相談できます。</p>
      </div>
      <a href="https://hdnjapan.com/consultation-form.html?cta_source=market-radar&cta_intent=research&cta_position=report_end">調査について相談する</a>
    </aside>
  </main>
</BaseLayout>
