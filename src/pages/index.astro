---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const [featured, ...rest] = articles;
const latest = rest.slice(0, 6);
const categoryCounts = [...articles.reduce((map, article) => {
  const category = article.data.category;
  map.set(category, (map.get(category) ?? 0) + 1);
  return map;
}, new Map<string, number>()).entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6);
const articleHref = (id: string) => `${import.meta.env.BASE_URL}articles/${id}/`;
const siteUrl = Astro.site ?? new URL('https://article.hdnjapan.com');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'HDN Articles',
  url: new URL(import.meta.env.BASE_URL, siteUrl).toString(),
  description: '医療経営、自由診療、患者導線、LINE活用、医療広告・関連法規を、クリニックの実務目線で整理するナレッジメディア。',
  publisher: {
    '@type': 'Organization',
    name: '株式会社HDN',
    url: 'https://hdnjapan.com/',
  },
};
---
<BaseLayout
  title="HDN Articles｜クリニック経営・自由診療・医療DXの実務ナレッジ"
  description="クリニック経営、自由診療導入、患者導線、LINE活用、医療DX、医療広告・関連法規を、現場で使える形に整理するHDNの実務ナレッジメディアです。"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main>
    <section class="home-hero" aria-labelledby="home-title">
      <div class="wrap hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">HDN KNOWLEDGE FOR CLINIC MANAGEMENT</p>
          <h1 id="home-title">クリニック経営の判断を、<br /><span>現場で使える知識</span>に。</h1>
          <p class="hero-lead">自由診療、患者導線、LINE・AI活用、医療広告。制度やニュースを紹介するだけでなく、「結局、現場では何を確認し、どう動くか」まで整理します。</p>
          <div class="hero-actions">
            <a class="button" href="#latest">最新記事を読む</a>
            <a class="text-link" href="https://hdnjapan.com/">HDNについて <span aria-hidden="true">→</span></a>
          </div>
          <ul class="trust-list" aria-label="HDN Articlesの編集方針">
            <li>一次情報を重視</li>
            <li>実務への落とし込み</li>
            <li>医療・法務の断定を避ける</li>
          </ul>
        </div>
        <aside class="hero-panel" aria-label="扱うテーマ">
          <p class="panel-kicker">PRACTICAL FOCUS</p>
          <h2>経営と現場の間にある<br />「実装の壁」を解く。</h2>
          <div class="focus-grid">
            <span>クリニック経営</span>
            <span>自由診療</span>
            <span>患者導線</span>
            <span>LINE / LHub</span>
            <span>医療DX・AI</span>
            <span>広告・法令対応</span>
          </div>
        </aside>
      </div>
    </section>

    {featured && (
      <section class="wrap featured-section" aria-labelledby="featured-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">EDITOR'S PICK</p>
            <h2 id="featured-title">まず読んでほしい最新記事</h2>
          </div>
          <a class="section-link" href="#latest">新着一覧へ <span aria-hidden="true">↓</span></a>
        </div>
        <article class="featured-card">
          <div class="featured-accent" aria-hidden="true"><span>HDN</span><strong>Insight</strong></div>
          <div class="featured-body">
            <p class="article-meta"><span>{featured.data.category}</span><time datetime={featured.data.publishedAt.toISOString()}>{featured.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
            <h3><a href={articleHref(featured.id)}>{featured.data.title}</a></h3>
            <p>{featured.data.description}</p>
            <a class="read-more" href={articleHref(featured.id)} aria-label={`${featured.data.title}を読む`}>記事を読む <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </section>
    )}

    {categoryCounts.length > 0 && (
      <section class="topic-band" aria-labelledby="topics-title">
        <div class="wrap topic-inner">
          <div class="topic-copy">
            <p class="eyebrow">TOPICS</p>
            <h2 id="topics-title">実務テーマから探す</h2>
            <p>経営課題から制度対応まで、クリニック運営に直結するテーマを横断して扱います。</p>
          </div>
          <div class="topic-list">
            {categoryCounts.map(([category, count]) => (
              <div class="topic-chip"><span>{category}</span><small>{count} articles</small></div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section id="latest" class="wrap latest-section" aria-labelledby="latest-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">LATEST ARTICLES</p>
          <h2 id="latest-title">新着記事</h2>
        </div>
        <p class="section-note">制度・経営・運用を、現場目線で。</p>
      </div>
      <div class="article-grid">
        {(latest.length ? latest : articles).map((article, index) => (
          <article class="article-card">
            <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
            <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
            <a class="read-more" href={articleHref(article.id)} aria-label={`${article.data.title}を読む`}>続きを読む <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="editorial-section">
      <div class="wrap editorial-grid">
        <div>
          <p class="eyebrow">OUR EDITORIAL STANDARD</p>
          <h2>検索のためではなく、<br />経営判断のための記事を。</h2>
        </div>
        <div class="editorial-points">
          <div><strong>01</strong><h3>一次情報を起点にする</h3><p>厚生労働省やPMDAなどの公開情報を確認し、事実とHDNの実務上の考察を分けて整理します。</p></div>
          <div><strong>02</strong><h3>「次に何をするか」まで書く</h3><p>制度の要約で終わらせず、院長・事務長・運営担当者が確認すべきポイントまで落とし込みます。</p></div>
          <div><strong>03</strong><h3>過度な断定をしない</h3><p>医療・法務・広告領域では、個別判断が必要な事項を一律にOK・NGと決めつけません。</p></div>
        </div>
      </div>
    </section>

    <section class="wrap home-cta" aria-labelledby="cta-title">
      <div>
        <p class="eyebrow">FROM KNOWLEDGE TO ACTION</p>
        <h2 id="cta-title">記事を読んで終わりではなく、<br />自院の運用に落とし込みたい方へ。</h2>
        <p>自由診療導入、患者導線、LINE活用、業務改善など、クリニックごとの状況に合わせて整理します。</p>
      </div>
      <div class="cta-actions">
        <a class="button" href="https://hdnjapan.com/">HDNの支援内容を見る</a>
        <a class="text-link" href="https://hdnjapan.com/lhub.html">LHubを見る <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
