---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isClinicArticle, isLHubArticle, isResearchArticle, isWorldFrictionsArticle } from '../lib/audiences';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles.filter((article) => article.id !== featured?.id).slice(0, 6);
const clinicArticles = articles.filter(isClinicArticle).slice(0, 3);
const lhubArticles = articles.filter(isLHubArticle).slice(0, 3);
const frictionsArticles = articles.filter(isWorldFrictionsArticle).slice(0, 3);
const researchArticles = articles.filter(isResearchArticle).slice(0, 3);
const articleHref = (id: string) => `${import.meta.env.BASE_URL}articles/${id}/`;
const laneHref = (slug: string) => `${import.meta.env.BASE_URL}${slug}/`;
const siteUrl = Astro.site ?? new URL('https://article.hdnjapan.com');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'HDN Articles',
  url: new URL(import.meta.env.BASE_URL, siteUrl).toString(),
  description: '医療・経営・テクノロジーと社会を、一次情報と実務の視点から読み解くHDNの編集メディア。',
  publisher: {
    '@type': 'Organization',
    name: '株式会社HDN',
    url: 'https://hdnjapan.com/',
  },
};

const laneCards = [
  {
    kicker: 'FOR CLINICS',
    title: '院長・クリニック関係者の方',
    description: '自費診療、患者導線、医療DX、医療広告、経営・業務改善を、現場で使える形に整理します。',
    href: laneHref('clinic'),
    link: 'クリニック向け記事へ',
  },
  {
    kicker: 'LHUB',
    title: 'LHub導入を検討している方',
    description: '予約・問診・決済・CRM・継続導線を、医療とその他業種に分けて活用事例から探せます。',
    href: laneHref('lhub'),
    link: 'LHub活用記事へ',
  },
  {
    kicker: 'WORLD FRICTIONS',
    title: '「世界の違和感」を読む',
    description: 'みんなが何となく「あれ？」と感じる社会のズレを、一次資料・研究・報道まで掘って言語化します。',
    href: laneHref('world-frictions'),
    link: '連載を読む',
  },
  {
    kicker: 'PRIMARY SOURCES',
    title: '制度・一次情報を確認したい方',
    description: '厚労省、PMDA、消費者庁などの公表情報を起点に、制度変更と実務上の論点を整理します。',
    href: laneHref('research'),
    link: '制度・一次情報へ',
  },
];
---
<BaseLayout
  title="HDN Articles｜医療・経営・テクノロジーと社会を一次情報から読み解く"
  description="院長・事務長の実務判断、LHub活用、制度改定、AI・社会の違和感まで。一次情報を確認し、何が起きているか、現場でどう考えるかまで整理するHDNの編集メディアです。"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main>
    <section class="home-hero" aria-labelledby="home-title">
      <div class="wrap hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">HDN ARTICLES — KNOWLEDGE, PRACTICE & PERSPECTIVE</p>
          <h1 id="home-title">医療・経営・テクノロジーと社会を、<br /><span>一次情報から読み解く。</span></h1>
          <p class="hero-lead">院長・事務長の実務判断、LHubの活用、制度改定、AI・社会の違和感まで。ニュースの要約ではなく、「何が起きているか」「現場でどう考えるか」まで整理します。</p>
          <div class="hero-actions">
            <a class="button" href="#audience-gateway">読む目的から選ぶ</a>
            <a class="text-link" href="#latest">最新記事を見る <span aria-hidden="true">↓</span></a>
          </div>
          <ul class="trust-list" aria-label="HDN Articlesの編集方針">
            <li>一次情報を重視</li>
            <li>事実と考察を分ける</li>
            <li>実務・判断につなげる</li>
          </ul>
        </div>
        <aside class="hero-panel" aria-label="読む目的から選ぶ">
          <p class="panel-kicker">START HERE</p>
          <h2>あなたに合う入口から、<br />迷わず記事へ。</h2>
          <div class="focus-grid knowledge-focus-grid">
            {laneCards.map((lane) => (
              <a href={lane.href}><span>{lane.title}</span><small>→</small></a>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section id="audience-gateway" class="wrap audience-gateway" aria-labelledby="audience-title">
      <div class="audience-gateway-head">
        <div>
          <p class="eyebrow">CHOOSE YOUR PATH</p>
          <h2 id="audience-title">誰が読んでも、入口で迷わない。</h2>
        </div>
        <p>クリニックの実務、LHubの導入検討、社会やAIを掘る「世界の違和感」、制度・一次情報。目的ごとに記事を分けて案内します。</p>
      </div>
      <div class="audience-grid">
        {laneCards.map((lane) => (
          <a class="audience-card" href={lane.href}>
            <small>{lane.kicker}</small>
            <h3>{lane.title}</h3>
            <p>{lane.description}</p>
            <span>{lane.link} →</span>
          </a>
        ))}
      </div>
    </section>

    {featured && (
      <section class="wrap featured-section" aria-labelledby="featured-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">EDITOR'S PICK</p>
            <h2 id="featured-title">まず読んでほしい一記事</h2>
          </div>
          <a class="section-link" href="#latest">新着一覧へ <span aria-hidden="true">↓</span></a>
        </div>
        <article class="featured-card">
          <div class="featured-accent" aria-hidden="true"><span>HDN</span><strong>Insight</strong></div>
          <div class="featured-body">
            <p class="article-meta"><span>{featured.data.category}</span><time datetime={featured.data.publishedAt.toISOString()}>{featured.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
            <h3><a href={articleHref(featured.id)}>{featured.data.title}</a></h3>
            <p>{featured.data.description}</p>
            <a class="read-more" href={articleHref(featured.id)} aria-label={`${featured.data.title}を読む`}>記事を読む <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </section>
    )}

    <section class="wrap editorial-lanes" aria-label="読者別の記事一覧">
      <section class="lane-block" aria-labelledby="clinic-lane-title">
        <div class="lane-heading">
          <div><p class="eyebrow">CLINIC KNOWLEDGE</p><h2 id="clinic-lane-title">クリニック経営・実務</h2></div>
          <a class="lane-link" href={laneHref('clinic')}>クリニック向けをすべて見る →</a>
        </div>
        <div class="article-grid">
          {clinicArticles.map((article, index) => (
            <article class="article-card">
              <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
              <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="lane-block" aria-labelledby="lhub-lane-title">
        <div class="lane-heading">
          <div><p class="eyebrow">LHUB USE CASES</p><h2 id="lhub-lane-title">LHub活用・導入事例</h2></div>
          <a class="lane-link" href={laneHref('lhub')}>LHub活用をすべて見る →</a>
        </div>
        <div class="article-grid">
          {lhubArticles.map((article, index) => (
            <article class="article-card">
              <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
              <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="lane-block" aria-labelledby="frictions-lane-title">
        <div class="lane-heading">
          <div><p class="eyebrow">WORLD FRICTIONS</p><h2 id="frictions-lane-title">世界の違和感</h2></div>
          <a class="lane-link" href={laneHref('world-frictions')}>連載をすべて見る →</a>
        </div>
        {frictionsArticles.length > 0 ? (
          <div class="article-grid">
            {frictionsArticles.map((article, index) => (
              <article class="article-card">
                <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
                <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
                <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
                <p>{article.data.description}</p>
                <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        ) : (
          <div class="topic-empty"><h3>「世界の違和感」はこれから正本化します。</h3><p>AI、働き方、広告、社会、都市などの調査記事を、このレーンへ順次蓄積します。</p></div>
        )}
      </section>

      <section class="lane-block" aria-labelledby="research-lane-title">
        <div class="lane-heading">
          <div><p class="eyebrow">PRIMARY SOURCES</p><h2 id="research-lane-title">制度・一次情報</h2></div>
          <a class="lane-link" href={laneHref('research')}>制度・一次情報をすべて見る →</a>
        </div>
        <div class="article-grid">
          {researchArticles.map((article, index) => (
            <article class="article-card">
              <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
              <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <a class="read-more" href={articleHref(article.id)}>続きを読む <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>
    </section>

    <section id="latest" class="wrap latest-section" aria-labelledby="latest-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">LATEST ARTICLES</p>
          <h2 id="latest-title">新着記事</h2>
        </div>
        <p class="section-note">分野を問わず、公開順に確認できます。</p>
      </div>
      <div class="article-grid">
        {(latest.length ? latest : articles).map((article, index) => (
          <article class="article-card">
            <div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <p class="article-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('ja-JP')}</time></p>
            <h3><a href={articleHref(article.id)}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
            <a class="read-more" href={articleHref(article.id)} aria-label={`${article.data.title}を読む`}>続きを読む <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="editorial-section">
      <div class="wrap editorial-grid">
        <div>
          <p class="eyebrow">OUR EDITORIAL STANDARD</p>
          <h2>要約ではなく、<br />判断に使える記事を。</h2>
        </div>
        <div class="editorial-points">
          <div><strong>01</strong><h3>一次情報を起点にする</h3><p>行政資料、研究、企業の公式情報、信頼できる報道を確認し、出典へ辿れる状態を基本にします。</p></div>
          <div><strong>02</strong><h3>事実と考察を分ける</h3><p>確認できた事実、報道・主張、HDNや羽田野の考察を混同せず、読み手が判断できるよう整理します。</p></div>
          <div><strong>03</strong><h3>「で、どう考えるか」まで書く</h3><p>医療実務では次の行動へ、社会テーマでは構造と問いへ。読んで終わらない記事を目指します。</p></div>
        </div>
      </div>
    </section>

    <section class="wrap home-cta" aria-labelledby="cta-title">
      <div>
        <p class="eyebrow">FROM KNOWLEDGE TO ACTION</p>
        <h2 id="cta-title">実務の相談先も、<br />読む場所も分ける。</h2>
        <p>クリニックの経営・患者導線はHDNへ。LHubの導入検討はLHubの案内へ。「世界の違和感」は営業導線を強制せず、記事そのものを読み続けられる構成にします。</p>
      </div>
      <div class="cta-actions">
        <a class="button" href="https://hdnjapan.com/consultation.html">クリニックの相談をする</a>
        <a class="text-link" href="https://hdnjapan.com/lhub.html">LHubを見る <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
