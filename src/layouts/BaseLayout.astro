---
import '../styles/global.css';
import '../styles/knowledge-hub.css';
const {
  title = 'HDN Articles',
  description = '医療経営、患者導線設計、自由診療、LINE活用に関する実務記事。',
  canonical,
  type = 'website',
  image,
  lang = 'ja',
  alternateJa,
  alternateEn,
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://article.hdnjapan.com');
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : new URL(Astro.url.pathname, siteUrl);
const imageUrl = image ? new URL(image, siteUrl) : undefined;
const jaUrl = alternateJa ? new URL(alternateJa, siteUrl) : undefined;
const enUrl = alternateEn ? new URL(alternateEn, siteUrl) : undefined;
const ogLocale = lang === 'en' ? 'en_US' : 'ja_JP';
const homeHref = lang === 'en' ? `${import.meta.env.BASE_URL}en/` : import.meta.env.BASE_URL;
const corporateHref = lang === 'en' ? 'https://hdnjapan.com/en/index.html' : 'https://hdnjapan.com/';
const lhubHref = lang === 'en' ? 'https://hdnjapan.com/en/lhub.html' : 'https://hdnjapan.com/lhub.html';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="Ip881HYfs6u_GNj9IVge1qsaCQulAB4EbtMHi7I8Psk" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {jaUrl && <link rel="alternate" hreflang="ja" href={jaUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {jaUrl && <link rel="alternate" hreflang="x-default" href={jaUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="HDN Articles" />
    <meta property="og:locale" content={ogLocale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="alternate" type="application/rss+xml" title="HDN Articles RSS" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-687Y8YTR90"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-687Y8YTR90');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={homeHref}>HDN Articles</a>
        <nav class="nav" aria-label={lang === 'en' ? 'Primary navigation' : '主要ナビゲーション'}>
          <a href={homeHref}>{lang === 'en' ? 'Articles' : '記事一覧'}</a>
          <a href={lhubHref}>LHub</a>
          <a href={corporateHref}>HDN Japan</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="footer"><div class="wrap">© HDN Inc.</div></footer>
  </body>
</html>
