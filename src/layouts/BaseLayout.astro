---
import '../styles/global.css';
import '../styles/knowledge-hub.css';
import '../styles/discovery.css';
const {
  title = 'HDN Articles',
  socialTitle,
  description = '医療経営、患者導線設計、自由診療、LINE活用に関する実務記事。',
  canonical,
  type = 'website',
  image,
  lang = 'ja',
  alternateJa,
  alternateEn,
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://article.hdnjapan.com');
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : new URL(Astro.url.pathname, siteUrl);
const imageUrl = image ? new URL(image, siteUrl) : undefined;
const jaUrl = alternateJa ? new URL(alternateJa, siteUrl) : undefined;
const enUrl = alternateEn ? new URL(alternateEn, siteUrl) : undefined;
const ogLocale = lang === 'en' ? 'en_US' : 'ja_JP';
const shareTitle = socialTitle || title;
const homeHref = lang === 'en' ? `${import.meta.env.BASE_URL}en/` : import.meta.env.BASE_URL;
const corporateHref = lang === 'en' ? 'https://hdnjapan.com/en/index.html' : 'https://hdnjapan.com/';
const productLhubHref = lang === 'en' ? 'https://hdnjapan.com/en/lhub.html' : 'https://hdnjapan.com/lhub.html';
const clinicHref = `${import.meta.env.BASE_URL}clinic/`;
const lhubArticlesHref = `${import.meta.env.BASE_URL}lhub/`;
const frictionsHref = `${import.meta.env.BASE_URL}world-frictions/`;
const researchHref = `${import.meta.env.BASE_URL}research/`;
const allArticlesHref = `${import.meta.env.BASE_URL}articles/`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="Ip881HYfs6u_GNj9IVge1qsaCQulAB4EbtMHi7I8Psk" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {jaUrl && <link rel="alternate" hreflang="ja" href={jaUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {jaUrl && <link rel="alternate" hreflang="x-default" href={jaUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="HDN Articles" />
    <meta property="og:locale" content={ogLocale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="alternate" type="application/rss+xml" title="HDN Articles RSS" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-687Y8YTR90"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-687Y8YTR90');

      document.addEventListener('click', (event) => {
        const target = event.target;
        const link = target instanceof Element ? target.closest('a[href]') : null;
        if (!link) return;

        const destination = new URL(link.href, window.location.href);
        const isCorporateDestination = destination.hostname === 'hdnjapan.com';
        const isAudienceLane = destination.hostname === window.location.hostname && [
          '/clinic/',
          '/lhub/',
          '/world-frictions/',
          '/research/',
          '/articles/',
        ].some((lane) => destination.pathname.endsWith(lane));

        if (isAudienceLane) {
          gtag('event', 'audience_lane_click', {
            source_path: window.location.pathname,
            destination_path: destination.pathname,
            link_text: (link.textContent || '').trim().slice(0, 100),
          });
        }

        const distributionChannel = link.getAttribute('data-distribution-channel');
        if (distributionChannel) {
          const distributionEvent = {
            newsletter: 'article_to_newsletter_click',
            note: 'article_to_note_click',
            linkedin: 'article_to_linkedin_click',
          }[distributionChannel];
          if (distributionEvent) {
            gtag('event', distributionEvent, {
              source_path: window.location.pathname,
              destination_host: destination.hostname,
              content_language: document.documentElement.lang || 'ja',
            });
          }
        }

        if (link.hasAttribute('data-world-frictions-related')) {
          gtag('event', 'world_frictions_related_click', {
            source_path: window.location.pathname,
            destination_path: destination.pathname,
          });
        }

        if (!isCorporateDestination) return;

        const pathname = destination.pathname;
        const destinationKey = pathname.includes('consultation')
          ? 'consultation'
          : pathname.includes('lhub')
            ? 'lhub'
            : pathname.includes('self-pay')
              ? 'self-pay'
              : pathname.includes('medical-sns')
                ? 'medical-sns'
                : 'corporate';
        const cta = link.closest('[data-contextual-service-cta]');

        gtag('event', 'article_to_hdn_click', {
          article_path: window.location.pathname,
          destination_key: destinationKey,
          cta_context: cta?.getAttribute('data-contextual-service-cta') || 'navigation',
          link_url: destination.href,
          link_text: (link.textContent || '').trim().slice(0, 100),
          content_language: document.documentElement.lang || 'ja',
        });
      });
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={homeHref}>HDN Articles</a>
        {lang === 'en' ? (
          <nav class="nav" aria-label="Primary navigation">
            <a href={homeHref}>Articles</a>
            <a href={productLhubHref}>LHub</a>
            <a href={corporateHref}>HDN Japan</a>
          </nav>
        ) : (
          <nav class="nav nav-ja" aria-label="主要ナビゲーション">
            <a href={clinicHref}>クリニック経営</a>
            <a href={lhubArticlesHref}>LHub活用</a>
            <a href={frictionsHref}>世界の違和感</a>
            <a href={researchHref}>制度・一次情報</a>
            <a href={allArticlesHref}>記事を探す</a>
            <a href={corporateHref}>HDN Japan</a>
          </nav>
        )}
      </div>
    </header>
    <slot />
    <footer class="footer"><div class="wrap">© HDN Inc.</div></footer>
  </body>
</html>
